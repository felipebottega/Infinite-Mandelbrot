bbcode_enabled = true
text = "[pulse freq=0.2 ease=10.0][b]About:[/b] This project is a Mandelbrot set explorer with arbitrary-precision arithmetic implemented in GLSL (shader language). This allows for an absurd level of zoom, going far beyond the usual float32 precision available in shaders.

[b]Controls:[/b] Simply adjust the parameters and click on the point where you want to zoom in. It is not possible to move sideways or zoom out.

[b]Warning:[/b] If your GPU is not powerful enough, increasing the precision level may cause the application to crash.

[b]Tip:[/b] You can use \"Where am I\" to copy your location in the fractal and then use \"Go to\" to return to exploring that same point at another time.[/pulse]"
